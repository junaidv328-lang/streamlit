# ═══════════════════════════════════════════════════════════════════════
#  SECRETS TEMPLATE — paste this into Streamlit Cloud's Secrets manager
# ═══════════════════════════════════════════════════════════════════════
#
#  WHERE TO PASTE THIS:
#  ───────────────────
#  Streamlit Cloud → your app → ⚙ Settings → Secrets → paste & Save
#
#  ⚠ NEVER commit this file to GitHub with real values filled in.
#  The .gitignore file in this repo already blocks .streamlit/secrets.toml
#  but double-check before every push.
#
# ═══════════════════════════════════════════════════════════════════════

# Password that gates the whole app.
# Pick something long and unique — not your Angel One password.
app_password = "REPLACE_WITH_A_STRONG_PASSPHRASE"

# Angel One SmartAPI credentials.
# Get these from https://smartapi.angelbroking.com/
[angel_one]
api_key   = "YOUR_SMARTAPI_KEY"
client_id = "YOUR_ANGEL_ONE_CLIENT_ID"
password  = "YOUR_TRADING_PASSWORD"
totp_key  = "YOUR_BASE32_TOTP_SECRET"
